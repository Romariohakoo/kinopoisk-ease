{
  "manifest_version": 3,
  "name": "Kinopoisk Ease",
  "version": "1.1.0",
  "description": "Удобная плашка для перехода к просмотру фильма или сериала на Кинопоиске",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "*://kinopoisk.ru/*",
        "*://*.kinopoisk.ru/*",
        "*://kinopoisk.com/*",
        "*://*.kinopoisk.com/*",
        "*://kinopoisk.kz/*",
        "*://*.kinopoisk.kz/*",
        "*://kinopoisk.by/*",
        "*://*.kinopoisk.by/*"
      ],
      "exclude_matches": [
        "*://hd.kinopoisk.ru/*",
        "*://hd.kinopoisk.com/*",
        "*://hd.kinopoisk.kz/*",
        "*://hd.kinopoisk.by/*"
      ],
      "js": ["src/lib.js", "src/extract.js", "src/widget.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2", "src/widget.css"],
      "matches": [
        "*://kinopoisk.ru/*",
        "*://*.kinopoisk.ru/*",
        "*://kinopoisk.com/*",
        "*://*.kinopoisk.com/*",
        "*://kinopoisk.kz/*",
        "*://*.kinopoisk.kz/*",
        "*://kinopoisk.by/*",
        "*://*.kinopoisk.by/*"
      ]
    }
  ]
}
